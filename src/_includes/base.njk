<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
  <link rel="icon" href="https://lhelectrical.co.uk/wp-content/uploads/2025/04/cropped-LH-Electrical-Favicon-270x270.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.domain }}{{ page.url }}">
  {% if schema %}
  <script type="application/ld+json">{{ schema | dump | safe }}</script>
  {% endif %}
</head>
<body>
  <header class="site-header" id="site-header">
    <div class="topbar">
      <div class="wrap topbar-inner">
        <span class="topbar-brand">{{ site.companyName }}</span>
        <div class="topbar-right">
          <a href="mailto:{{ site.email }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/></svg>
            {{ site.email }}
          </a>
          <span class="topbar-divider"></span>
          <span>{{ site.hours }}</span>
        </div>
      </div>
    </div>
    <div class="wrap header-inner">
      <a class="logo" href="/"><img src="https://lhelectrical.co.uk/wp-content/uploads/2025/03/LH-Electrical-Logo-white.png" alt="{{ site.companyName }}" height="40" style="display:block"></a>
      <nav class="main-nav" id="main-nav">
        <ul>
          {% for item in site.nav %}
          {% if item.label == "Services" %}
          <li class="has-dropdown">
            <a href="{{ item.url }}">{{ item.label }} <span class="caret">&#9662;</span></a>
            <div class="dropdown-menu">
              {% for s in site.services %}<a href="{{ s.url }}"><span class="drop-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg></span><span class="drop-text">{{ s.label }}</span></a>{% endfor %}
            </div>
          </li>
          {% elif item.label == "Locations" %}
          <li class="has-dropdown">
            <a href="{{ item.url }}">{{ item.label }} <span class="caret">&#9662;</span></a>
            <div class="dropdown-menu">
              {% for l in site.locations %}<a href="{{ l.url }}"><span class="drop-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M12 21s7-6.5 7-12a7 7 0 10-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg></span><span class="drop-text">{{ l.label }}</span></a>{% endfor %}
            </div>
          </li>
          {% else %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endif %}
          {% endfor %}
        </ul>
      </nav>
      <div class="header-actions">
        <a class="btn btn-call nav-call" href="{{ site.phoneHref }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          {{ site.phone }}
        </a>
        <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <div class="mobile-nav" id="mobile-nav">
    <button class="mobile-nav-close" id="mobile-nav-close" aria-label="Close menu">&times;</button>
    <span class="mobile-nav-section">Main</span>
    {% for item in site.nav %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
    <span class="mobile-nav-section">Services</span>
    {% for s in site.services %}<a href="{{ s.url }}">{{ s.label }}</a>{% endfor %}
    <span class="mobile-nav-section">Locations</span>
    {% for l in site.locations %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
    <a class="btn btn-primary mobile-nav-cta" href="{{ site.phoneHref }}">{{ site.phone }}</a>
  </div>

  <main>
    {{ content | safe }}
  </main>

  <section class="cta-band">
    <div class="wrap cta-inner">
      <div>
        <h2>Need an electrician you can rely on?</h2>
        <p>Fixed written quotes, no hidden costs. Call us or request a quote online.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href="/contact/">Get your free no-obligation quote</a>
        <a class="btn btn-outline" href="{{ site.phoneHref }}">{{ site.phone }}</a>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <h3>{{ site.companyName }}</h3>
        <p>{{ site.address }}</p>
        <p><a href="{{ site.phoneHref }}">{{ site.phone }}</a></p>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p>{{ site.hours }}</p>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          {% for s in site.services %}
          <li><a href="{{ s.url }}">{{ s.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h4>Locations</h4>
        <ul>
          {% for l in site.locations %}
          <li><a href="{{ l.url }}">{{ l.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h4>Credentials</h4>
        <ul class="credentials-list">
          {% for c in site.credentials %}
          <li>{{ c }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="wrap footer-bottom">
      <p>&copy; {{ "" | year }} {{ site.companyName }}. All rights reserved. Design by Summit Up Digital.</p>
    </div>
  </footer>
  <script src="/scripts/nav.js" defer></script>
  <script src="/scripts/typewriter.js" defer></script>
</body>
</html>
