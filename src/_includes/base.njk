<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
  {% if noindex %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}
  <link rel="icon" href="/images/brand/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.domain }}{{ page.url }}">
  {% if schema %}
  {% for s in schema %}
  <script type="application/ld+json">{{ s | dump | safe }}</script>
  {% endfor %}
  {% endif %}
  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@type": "Electrician",
    "@id": "{{ site.domain }}/#business",
    "name": "{{ site.companyName }}",
    "url": "{{ site.domain }}/",
    "telephone": "+441273443324",
    "email": "{{ site.email }}",
    "image": "{{ site.domain }}/images/hero/homepage-hero-consumer-unit.jpg",
    "logo": "{{ site.domain }}/images/brand/favicon.png",
    "address": {"@type": "PostalAddress", "streetAddress": "Cowlease Farm, North End Lane", "addressLocality": "Lewes", "addressRegion": "East Sussex", "postalCode": "BN8 5TE", "addressCountry": "GB"},
    "openingHoursSpecification": [{"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "08:00", "closes": "17:00"}],
    "areaServed": ["Lewes", "Ringmer", "Uckfield", "Hailsham", "Peacehaven", "Seaford", "East Sussex"],
    "sameAs": ["https://www.facebook.com/lhelectricalsussex", "{{ site.trustpilotLink }}"],
    "aggregateRating": {"@type": "AggregateRating", "ratingValue": "{{ site.reviewRating }}", "reviewCount": "{{ site.reviewCount }}"}
  }</script>
</head>
<body>
  <header class="site-header" id="site-header">
    <div class="topbar">
      <div class="wrap topbar-inner">
        <div class="topbar-left">
          <span class="topbar-cert-logos">
            <img src="/images/logos/napit-logo.png" alt="NAPIT registered">
            <img src="/images/logos/recc-logo.png" alt="RECC certified">
            <img src="/images/logos/mcs-logo.png" alt="MCS certified">
          </span>
          <span class="topbar-divider topbar-center-divider"></span>
          <span class="topbar-center">
            <img src="/images/logos/trustpilot-stars-white.png" alt="Trustpilot: Excellent, rated {{ site.trustpilotRating }} out of 5">
            <img src="/images/logos/trustpilot-wordmark-white.png" alt="Trustpilot">
          </span>
        </div>
        <div class="topbar-right">
          {% if site.social and site.social.length %}
          <span class="topbar-social">
            {% for s in site.social %}
            <a href="{{ s.url }}" target="_blank" rel="noopener" aria-label="{{ s.label }}" title="{{ s.label }}">
              {% if s.icon == "facebook" %}<svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
              {% elif s.icon == "instagram" %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><rect x="2.5" y="2.5" width="19" height="19" rx="5.2"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/></svg>
              {% elif s.icon == "linkedin" %}<svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.7c0-1.36-.03-3.11-1.95-3.11-1.96 0-2.26 1.48-2.26 3.01V21h-4z"/></svg>
              {% elif s.icon == "x" %}<svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.22-6.82-5.96 6.82H1.68l7.73-8.84L1.25 2.25h6.82l4.71 6.23zm-1.16 17.52h1.83L7.01 4.13H5.05z"/></svg>
              {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><circle cx="12" cy="12" r="9"/><path d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18 15 15 0 010-18z"/></svg>
              {% endif %}
            </a>
            {% endfor %}
          </span>
          <span class="topbar-divider"></span>
          {% endif %}
          <a href="mailto:{{ site.email }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/></svg>
            {{ site.email }}
          </a>
          <span class="topbar-divider"></span>
          <span>{{ site.hours }}</span>
        </div>
      </div>
    </div>
    <div class="wrap header-inner">
      <a class="logo" href="/"><img src="/images/brand/lh-electrical-logo-white.png" alt="{{ site.companyName }}" height="40" style="display:block"></a>
      <nav class="main-nav" id="main-nav">
        <ul>
          {% for item in site.nav %}
          {% if item.url == "/electrical-services/" %}
          <li class="has-dropdown has-dropdown-wide">
            <a href="{{ item.url }}">{{ item.label }} <span class="caret">&#9662;</span></a>
            <div class="dropdown-menu dropdown-wide">
              <p class="dropdown-section-label">Electrical Services</p>
              <div class="dropdown-grid">
                {% for s in site.services %}{% if s.label != "EV Chargers" and s.label != "Solar Panels & Storage" %}<a class="drop-card" href="{{ s.url }}"><span class="drop-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg></span><span class="drop-card-text"><span class="drop-title">{{ s.label }}</span><span class="drop-desc">{{ s.desc }}</span></span></a>{% endif %}{% endfor %}
              </div>
            </div>
          </li>
          {% elif item.url == "/solar-panels/" %}
          <li class="has-dropdown">
            <a href="{{ item.url }}">{{ item.label }} <span class="caret">&#9662;</span></a>
            <div class="dropdown-menu">
              {% for s in site.services %}{% if s.label == "EV Chargers" or s.label == "Solar Panels & Storage" %}<a href="{{ s.url }}"><span class="drop-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg></span><span class="drop-text">{{ s.label }}</span></a>{% endif %}{% endfor %}
            </div>
          </li>
          {% else %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endif %}
          {% endfor %}
        </ul>
      </nav>
      <div class="header-actions">
        <a class="btn btn-call nav-call" href="{{ site.phoneHref }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          {{ site.phone }}
        </a>
        <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <div class="mobile-nav" id="mobile-nav">
    <button class="mobile-nav-close" id="mobile-nav-close" aria-label="Close menu">&times;</button>
    <span class="mobile-nav-section">Main</span>
    {% for item in site.nav %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
    <span class="mobile-nav-section">Electrical</span>
    {% for s in site.services %}{% if s.label != "EV Chargers" and s.label != "Solar Panels & Storage" %}<a href="{{ s.url }}">{{ s.label }}</a>{% endif %}{% endfor %}
    <span class="mobile-nav-section">Solar / EV</span>
    {% for s in site.services %}{% if s.label == "EV Chargers" or s.label == "Solar Panels & Storage" %}<a href="{{ s.url }}">{{ s.label }}</a>{% endif %}{% endfor %}
    <a class="btn btn-primary mobile-nav-cta" href="{{ site.phoneHref }}">{{ site.phone }}</a>
  </div>

  <main>
    {{ content | safe }}
  </main>

  {% if not hideCtaBand %}
  <section class="cta-band">
    <div class="wrap cta-inner">
      <div>
        <h2>Need an electrician you can rely on?</h2>
        <p>Fixed written quotes, no hidden costs. Call us or request a quote online.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href="/contact/">Get your free no-obligation quote</a>
        <a class="btn btn-outline" href="{{ site.phoneHref }}">{{ site.phone }}</a>
      </div>
    </div>
  </section>
  {% endif %}

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <img class="footer-logo" src="/images/brand/lh-electrical-logo-white.png" alt="{{ site.companyName }}">
        <ul class="footer-contact">
          <li><svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg><a href="{{ site.phoneHref }}">{{ site.phone }}</a></li>
          <li><svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/></svg><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>{{ site.hours }}</li>
        </ul>
        <h4 class="footer-credentials-head">Credentials</h4>
        <div class="footer-cert-logos">
          <a href="https://www.recc.org.uk/scheme/members/00078267-lh-electrical-south-east-limited" target="_blank" rel="noopener nofollow"><img src="/images/logos/recc-badge.jpg" alt="Renewable Energy Consumer Code member"></a>
          <a href="https://search.napit.org.uk/member/23182/lh-electrical-south-east-limited" target="_blank" rel="noopener nofollow"><img src="/images/logos/napit-badge.jpg" alt="NAPIT registered electrical contractor"></a>
          <a href="https://mcscertified.com/" target="_blank" rel="noopener nofollow"><img src="/images/logos/mcs-badge.jpg" alt="MCS certified installer"></a>
        </div>
      </div>
      <div>
        <h4>Services</h4>
        <ul class="footer-links">
          {% for s in site.services %}
          <li><a href="{{ s.url }}">{{ s.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h4>Locations</h4>
        <ul class="footer-links">
          {% for l in site.locations %}
          <li><a href="{{ l.url }}">{{ l.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h4>Site</h4>
        <ul class="footer-links">
          {% for item in site.nav %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
          <li><a href="/blog/">Blog</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap footer-bottom">
      <p>{{ site.address }}<br>&copy; {{ "" | year }} {{ site.companyName }}. All rights reserved. <a href="/privacy-policy/">Privacy Policy</a> &middot; <button type="button" class="footer-link-button" data-cookie-settings>Cookie settings</button>. Design by <a href="https://summitupdigital.co.uk/" target="_blank" rel="noopener">Summit Up Digital</a>.</p>
    </div>
  </footer>

  <button type="button" class="back-to-top" id="back-to-top" aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
  </button>

  <div class="mobile-cta-bar" id="mobile-cta-bar">
    <a class="mobile-cta-btn mobile-cta-call" href="{{ site.phoneHref }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
      Call Now
    </a>
    <a class="mobile-cta-btn mobile-cta-quote" href="/contact/">Get a Quote</a>
  </div>

  <script src="/scripts/cookie-consent.js" defer></script>
  <script src="/scripts/nav.js" defer></script>
  <script src="/scripts/typewriter.js" defer></script>
  <script src="/scripts/reviewCarousel.js" defer></script>
  <script src="/scripts/scrollReveal.js" defer></script>
  <script src="/scripts/counter.js" defer></script>
  <script src="/scripts/servicePicker.js" defer></script>
  <script src="/scripts/svcCarousel.js" defer></script>
  <script src="/scripts/heroIllustrationRotator.js" defer></script>
</body>
</html>
