---
layout: base.njk
hideCtaBand: true
---
<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ heading | dump | safe }},
  "description": {{ description | dump | safe }},
  "image": "{{ site.domain }}{{ image }}",
  "datePublished": "{{ date | dateISO }}",
  "mainEntityOfPage": "{{ site.domain }}{{ page.url }}",
  "author": {"@id": "{{ site.domain }}/#business"},
  "publisher": {"@id": "{{ site.domain }}/#business"}
}</script>
<section class="blog-hero-photo">
  <div class="blog-hero-photo-bg">
    <img src="{{ image }}" alt="{{ imageAlt }}">
  </div>
  <div class="wrap">
    <div class="blog-hero-card{% if heroCardDark %} is-dark{% endif %}">
      <div class="blog-hero-card-inner">
        {% if heroIcon %}<img class="blog-hero-icon" src="{{ heroIcon }}" alt="">{% endif %}
        <div>
          <span class="svc-eyebrow">{{ category }}</span>
          <h1 class="blog-hero-title">{{ heading }}</h1>
          <div class="blog-meta-row">
            <a class="blog-back-link" href="{{ backUrl | default('/blog/') }}">&larr; {{ backLabel | default('Back to Blog') }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="svc-included-band">
  <div class="wrap">
    <div class="svc-included-grid">
      <article class="blog-prose">
        {{ content | safe }}
      </article>
      <div class="svc-included-sidebar">
        <div class="svc-info-card">
          <span class="svc-info-card-eyebrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
            Blog Articles
          </span>
          <ul class="svc-blog-list">
            {% for post in collections.post | reverse %}
            {% if post.url != page.url %}
            <li><a href="{{ post.url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg> {{ post.data.heading }}{% if not (post.data.heading.endsWith('?') or post.data.heading.endsWith('.') or post.data.heading.endsWith('!')) %}.{% endif %}</a></li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>
        {% svcQualificationsCard %}
        {% svcQuoteCard "project" %}
      </div>
    </div>
  </div>
</section>

{% set relatedPosts = [] %}
{% for post in collections.post | reverse %}
{% if post.url != page.url and relatedPosts.length < 3 %}
{% set _ = relatedPosts.push(post) %}
{% endif %}
{% endfor %}
{% if relatedPosts.length %}
<section class="section home-blog-band">
  <div class="wrap">
    <div class="home-blog-head">
      <span class="svc-eyebrow">Keep Reading</span>
      <h2 style="text-align:center; margin-top:14px;">More From The Blog</h2>
    </div>
    <div class="blog-grid">
      {% for post in relatedPosts %}
      <a class="blog-card" href="{{ post.url }}">
        <div class="blog-card-img"><img src="{{ post.data.image }}" alt="{{ post.data.imageAlt }}" loading="lazy"></div>
        <div class="blog-card-body">
          <span class="blog-card-cat">{{ post.data.category }}</span>
          <h3>{{ post.data.heading }}</h3>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="svc-cta-band">
  <div class="wrap">
    <h2 class="svc-display svc-h2">Ready When You Are</h2>
    <p>Free survey, fixed written quote, no obligation. Call us or send over the details and we&rsquo;ll come back to you.</p>
    <div class="svc-actions" style="justify-content:center;">
      <a class="btn btn-on-accent btn-pill-lg" href="{{ site.phoneHref }}">Call {{ site.phone }}</a>
      <a class="btn btn-on-accent-ghost btn-pill-lg" href="/contact/">Get a Free Quote</a>
    </div>
  </div>
</section>
