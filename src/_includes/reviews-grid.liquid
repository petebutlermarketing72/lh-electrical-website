<div class="rv-grid">
  {%- if googleReviews.fetched -%}
  {%- for r in googleReviews.reviews -%}
  {%- assign nameParts = r.author | split: ' ' -%}
  <div class="rv-tile{% if forloop.first %} is-featured{% endif %}">
    {%- if forloop.first %}<span class="rv-featured-tag">Featured</span>{% endif -%}
    <div class="rv-tile-stars">{% for i in (1..5) %}{% if i <= r.rating %}&#9733;{% else %}&#9734;{% endif %}{% endfor %}</div>
    <p>&ldquo;{{ r.text }}&rdquo;</p>
    <div class="rv-tile-meta">
      <div class="rv-avatar"><img src="/images/logos/google-logo.svg" alt="Google"></div>
      <div>
        <div class="rv-name">{{ r.author }}</div>
        <div class="rv-source">Google Review &middot; {{ r.relativeTime }}</div>
      </div>
    </div>
  </div>
  {%- endfor -%}
  {%- else -%}
  <div class="rv-tile is-featured">
    <span class="rv-featured-tag">Featured</span>
    <div class="rv-tile-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <p>&ldquo;We were very pleased with the work on our power sockets and lighting done by Luke Hartery and his team (George and Finn) &mdash; pleasant, efficient and helpful.&rdquo;</p>
    <div class="rv-tile-meta">
      <div class="rv-avatar"><img src="/images/logos/google-logo.svg" alt="Google"></div>
      <div>
        <div class="rv-name">Chris Cooper</div>
        <div class="rv-source">Google Review</div>
      </div>
    </div>
  </div>
  <div class="rv-tile">
    <div class="rv-tile-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <p>&ldquo;We contacted LH Electrical to complete the EICR test on our retail premises, this was completed quickly by Luke &amp; George, clearly setting out the work required. A really competitive price but more important to me, the work has completed as agreed and to a very high standard.&rdquo;</p>
    <div class="rv-tile-meta">
      <div class="rv-avatar"><img src="/images/logos/google-logo.svg" alt="Google"></div>
      <div>
        <div class="rv-name">Greg Milton</div>
        <div class="rv-source">Google Review</div>
      </div>
    </div>
  </div>
  <div class="rv-tile">
    <div class="rv-tile-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <p>&ldquo;Luke did all the electrical works on the renovation of the old farmhouse and various outbuildings, including lighting and sound in an old Sussex barn. Luke and George make a great team; calmly getting on with the job with efficiency and skill.&rdquo;</p>
    <div class="rv-tile-meta">
      <div class="rv-avatar"><img src="/images/logos/google-logo.svg" alt="Google"></div>
      <div>
        <div class="rv-name">Rebecca K</div>
        <div class="rv-source">Google Review</div>
      </div>
    </div>
  </div>
  <div class="rv-tile">
    <div class="rv-tile-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <p>&ldquo;The initial assessment was carried out in a friendly and efficient way by Luke. A few days later, the job was completed by George who worked quickly, efficiently and tidily.&rdquo;</p>
    <div class="rv-tile-meta">
      <div class="rv-avatar"><img src="/images/logos/google-logo.svg" alt="Google"></div>
      <div>
        <div class="rv-name">Tony Sims</div>
        <div class="rv-source">Google Review</div>
      </div>
    </div>
  </div>
  <div class="rv-tile">
    <div class="rv-tile-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <p>&ldquo;Great outfit. The lads did a very good job neatly and efficiently, and were careful and pleasant as they went about their work.&rdquo;</p>
    <div class="rv-tile-meta">
      <div class="rv-avatar"><img src="/images/logos/google-logo.svg" alt="Google"></div>
      <div>
        <div class="rv-name">Andrew Morgan</div>
        <div class="rv-source">Google Review</div>
      </div>
    </div>
  </div>
  <div class="rv-tile">
    <div class="rv-tile-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <p>&ldquo;Excellent communication, reliable, thorough, helpful. Many thanks.&rdquo;</p>
    <div class="rv-tile-meta">
      <div class="rv-avatar"><img src="/images/logos/google-logo.svg" alt="Google"></div>
      <div>
        <div class="rv-name">Julie Frances</div>
        <div class="rv-source">Google Review</div>
      </div>
    </div>
  </div>
  <div class="rv-tile">
    <div class="rv-tile-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <p>&ldquo;Luke provided a clear quote for our ground floor refurb on our large 1930s house. Easy to deal with, honest, thoughtful consultancy and transparent pricing.&rdquo;</p>
    <div class="rv-tile-meta">
      <div class="rv-avatar"><img src="/images/logos/google-logo.svg" alt="Google"></div>
      <div>
        <div class="rv-name">Stu T</div>
        <div class="rv-source">Google Review</div>
      </div>
    </div>
  </div>
  <div class="rv-tile">
    <div class="rv-tile-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <p>&ldquo;We&rsquo;ve been working with LH Electrical since 2017. They handled all the electrical wiring for my coffee house from the ground up, done professionally, on time and to a very high standard.&rdquo;</p>
    <div class="rv-tile-meta">
      <div class="rv-avatar"><img src="/images/logos/google-logo.svg" alt="Google"></div>
      <div>
        <div class="rv-name">U&#287;ur Pekyildiz</div>
        <div class="rv-source">Google Review</div>
      </div>
    </div>
  </div>
  {%- endif %}
</div>
